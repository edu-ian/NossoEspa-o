rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Funções de Autenticação e Autorização)
    // =========================================================================

    // Verifica se a requisição é feita por um usuário autenticado no Firebase Auth
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verifica se o usuário autenticado é o dono do recurso especificado pelo userId
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Recupera dados do usuário autenticado no documento /users/{uid}
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário atual é membro ativo do espaço/casal informado:
    // Suporta o novo modelo de multi-espaços (slots até 3) e retrocompatibilidade com coupleId único:
    // 1) Checa se o usuário está na lista de members ou é partner1Id/partner2Id no documento do casal
    // 2) Ou checa se o spaceId está no array spaceIds (ou coupleId) do perfil do usuário
    function isCoupleMember(coupleId) {
      return isSignedIn() && coupleId != null && coupleId != "" && (
        (exists(/databases/$(database)/documents/couples/$(coupleId)) && (
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.get('members', []) ||
          get(/databases/$(database)/documents/couples/$(coupleId)).data.get('partner1Id', '') == request.auth.uid ||
          get(/databases/$(database)/documents/couples/$(coupleId)).data.get('partner2Id', '') == request.auth.uid
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          coupleId in getUserData().get('spaceIds', []) ||
          getUserData().get('coupleId', '') == coupleId
        ))
      );
    }

    // Validações básicas de formato e tamanho de dados
    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // =========================================================================
    // PADRÃO DE SEGURANÇA: Bloqueia tudo por padrão
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLEÇÃO: /test/connection
    // Permite testar a conectividade no boot do app sem vazar dados sensíveis
    // =========================================================================
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // COLEÇÃO: /users/{userId}
    // Armazena perfis dos usuários (nome, e-mail, foto, array de slots spaceIds)
    // =========================================================================
    match /users/{userId} {
      // Leitura permitida para usuários autenticados (necessário para carregar parceiros)
      allow read: if isSignedIn();

      // Criação permitida apenas para o próprio usuário autenticado
      allow create: if isOwner(userId)
        && isNonEmptyString(request.resource.data.get('email', ''), 3, 128);

      // Atualização permitida para o dono do perfil (limite de até 3 espaços no array spaceIds)
      allow update: if isOwner(userId)
        && request.resource.data.get('spaceIds', []).size() <= 3;

      // Exclusão da conta pelo próprio usuário
      allow delete: if isOwner(userId);
    }

    // =========================================================================
    // COLEÇÃO: /couples/{coupleId}
    // Espaços compartilhados de casais (slots com no máximo 2 membros por espaço)
    // =========================================================================
    match /couples/{coupleId} {
      // Leitura permitida para autenticados (permite consultar códigos NOSSO-XXX ao parear e carregar slots)
      allow read: if isSignedIn();

      // Criação: apenas o usuário autenticado como parceiro 1 ou membro inicial
      allow create: if isSignedIn()
        && (
          request.resource.data.get('partner1Id', '') == request.auth.uid ||
          request.auth.uid in request.resource.data.get('members', [])
        )
        && isNonEmptyString(request.resource.data.get('code', ''), 4, 30);

      // Atualização permitida sob regras estritas:
      // Caso 1: Usuário já é membro ativo ou parceiro do espaço
      // Caso 2: Novo parceiro conectando-se na vaga livre de partner2 (máx 2 membros)
      allow update: if isSignedIn() && (
        (
          request.auth.uid in resource.data.get('members', []) ||
          resource.data.get('partner1Id', '') == request.auth.uid ||
          resource.data.get('partner2Id', '') == request.auth.uid
        )
        ||
        (
          (resource.data.get('partner2Id', '') == '' || resource.data.get('partner2Id', null) == null) &&
          request.resource.data.get('partner2Id', '') == request.auth.uid &&
          request.resource.data.get('partner1Id', '') == resource.data.get('partner1Id', '') &&
          request.resource.data.get('code', '') == resource.data.get('code', '') &&
          request.resource.data.get('members', []).size() <= 2
        )
      );

      // Exclusão permitida apenas se o usuário for um dos membros ou parceiros
      allow delete: if isSignedIn() && (
        request.auth.uid in resource.data.get('members', []) ||
        resource.data.get('partner1Id', '') == request.auth.uid ||
        resource.data.get('partner2Id', '') == request.auth.uid
      );
    }

    // =========================================================================
    // COLEÇÃO: /events/{eventId}
    // Eventos, shows, viagens e aniversários da timeline do casal
    // =========================================================================
    match /events/{eventId} {
      allow read: if isSignedIn() && isCoupleMember(resource.data.coupleId);

      allow create: if isSignedIn()
        && isCoupleMember(request.resource.data.coupleId)
        && request.resource.data.createdBy == request.auth.uid
        && isNonEmptyString(request.resource.data.title, 1, 150)
        && isNonEmptyString(request.resource.data.category, 1, 50)
        && isNonEmptyString(request.resource.data.dateTime, 1, 64);

      allow update: if isSignedIn()
        && isCoupleMember(resource.data.coupleId)
        && request.resource.data.coupleId == resource.data.coupleId;

      allow delete: if isSignedIn() && isCoupleMember(resource.data.coupleId);
    }

    // =========================================================================
    // COLEÇÃO: /media_items/{mediaItemId}
    // Filmes, séries, livros, lugares e itens de listas personalizadas com notas
    // =========================================================================
    match /media_items/{mediaItemId} {
      allow read: if isSignedIn() && isCoupleMember(resource.data.coupleId);

      allow create: if isSignedIn()
        && isCoupleMember(request.resource.data.coupleId)
        && request.resource.data.createdBy == request.auth.uid
        && isNonEmptyString(request.resource.data.title, 1, 150)
        && isNonEmptyString(request.resource.data.type, 1, 40)
        && isNonEmptyString(request.resource.data.status, 1, 40);

      allow update: if isSignedIn()
        && isCoupleMember(resource.data.coupleId)
        && request.resource.data.coupleId == resource.data.coupleId;

      allow delete: if isSignedIn() && isCoupleMember(resource.data.coupleId);
    }

    // =========================================================================
    // COLEÇÃO: /custom_lists/{listId}
    // Temas e categorias customizadas criadas pelo casal
    // =========================================================================
    match /custom_lists/{listId} {
      allow read: if isSignedIn() && isCoupleMember(resource.data.coupleId);

      allow create: if isSignedIn()
        && isCoupleMember(request.resource.data.coupleId)
        && isNonEmptyString(request.resource.data.name, 1, 100);

      allow update: if isSignedIn()
        && isCoupleMember(resource.data.coupleId)
        && request.resource.data.coupleId == resource.data.coupleId;

      allow delete: if isSignedIn() && isCoupleMember(resource.data.coupleId);
    }

    // =========================================================================
    // COLEÇÃO: /questions/{questionId}
    // Cartas de perguntas e diálogos customizados do casal
    // =========================================================================
    match /questions/{questionId} {
      allow read: if isSignedIn() && (
        resource.data.get('coupleId', '') == '' ||
        isCoupleMember(resource.data.get('coupleId', ''))
      );

      allow create: if isSignedIn()
        && isCoupleMember(request.resource.data.get('coupleId', ''))
        && request.resource.data.get('isCustom', false) == true
        && isNonEmptyString(request.resource.data.get('text', ''), 1, 500)
        && isNonEmptyString(request.resource.data.get('category', ''), 1, 60);

      allow update: if isSignedIn()
        && isCoupleMember(resource.data.get('coupleId', ''))
        && request.resource.data.get('coupleId', '') == resource.data.get('coupleId', '');

      allow delete: if isSignedIn()
        && resource.data.get('isCustom', false) == true
        && isCoupleMember(resource.data.get('coupleId', ''));
    }
  }
}
