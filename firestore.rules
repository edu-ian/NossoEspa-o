rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/couples/$(coupleId)) && (
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.members != null &&
           request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members) ||
          get(/databases/$(database)/documents/couples/$(coupleId)).data.partner1Id == request.auth.uid ||
          get(/databases/$(database)/documents/couples/$(coupleId)).data.partner2Id == request.auth.uid
        )
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Users collection: owner can modify, authenticated users can read to pair
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // Couples/Spaces collection: authenticated can query codes to join & view slots; members can update/delete
    match /couples/{coupleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.partner1Id == request.auth.uid ||
        (request.resource.data.members != null && request.auth.uid in request.resource.data.members)
      );
      // Strict update rule: only existing members OR a valid joining user claiming an empty partner2 slot
      allow update: if isSignedIn() && (
        // Case 1: Active space member updating space info (cannot change invite code or partner1Id)
        (
          ((resource.data.members != null && request.auth.uid in resource.data.members) ||
           resource.data.partner1Id == request.auth.uid ||
           resource.data.partner2Id == request.auth.uid) &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.partner1Id == resource.data.partner1Id
        ) ||
        // Case 2: New partner joining vacant partner2 slot (strictly bounded to max 2 members)
        (
          (resource.data.partner2Id == null || resource.data.partner2Id == "") &&
          request.resource.data.partner2Id == request.auth.uid &&
          request.resource.data.partner1Id == resource.data.partner1Id &&
          request.resource.data.code == resource.data.code &&
          (request.resource.data.members == null || request.resource.data.members.size() <= 2)
        )
      );
      allow delete: if isSignedIn() && (
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        resource.data.partner1Id == request.auth.uid ||
        resource.data.partner2Id == request.auth.uid
      );
    }

    // Events collection: only partner members can read and manage their events
    match /events/{eventId} {
      allow read: if isSignedIn() && (resource.data.coupleId == null || isCoupleMember(resource.data.coupleId));
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid && isCoupleMember(request.resource.data.coupleId);
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isCoupleMember(resource.data.coupleId));
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isCoupleMember(resource.data.coupleId));
    }

    // Media Items collection (Filmes, Séries, Livros, Lugares, Listas temáticas)
    match /media_items/{mediaItemId} {
      allow read: if isSignedIn() && (resource.data.coupleId == null || isCoupleMember(resource.data.coupleId));
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid && isCoupleMember(request.resource.data.coupleId);
      allow update: if isSignedIn() && isCoupleMember(resource.data.coupleId);
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isCoupleMember(resource.data.coupleId));
    }

    // Custom lists / thematic collections
    match /custom_lists/{listId} {
      allow read: if isSignedIn() && (resource.data.coupleId == null || isCoupleMember(resource.data.coupleId));
      allow create: if isSignedIn() && isCoupleMember(request.resource.data.coupleId);
      allow update: if isSignedIn() && isCoupleMember(resource.data.coupleId);
      allow delete: if isSignedIn() && isCoupleMember(resource.data.coupleId);
    }

    // Questions collection
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.coupleId == null || isCoupleMember(request.resource.data.coupleId));
      allow update: if isSignedIn() && (resource.data.coupleId == null || isCoupleMember(resource.data.coupleId));
      allow delete: if isSignedIn() && resource.data.isCustom == true && (resource.data.createdBy == request.auth.uid || isCoupleMember(resource.data.coupleId));
    }
  }
}
