# ===================================================================
# CONFIGURAÇÕES DO FIREBASE (CLIENT-SIDE VITE)
# ===================================================================
# No Firebase Console (https://console.firebase.google.com/):
# 1. Acesse: Configurações do Projeto (ícone de engrenagem) > Geral
# 2. Em "Seus aplicativos", selecione seu app Web (ou crie um se não existir)
# 3. Copie os valores de "Configuração do SDK" e preencha abaixo:

VITE_FIREBASE_API_KEY="sua-api-key-aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="seu-messaging-sender-id"
VITE_FIREBASE_APP_ID="seu-app-id"
VITE_FIREBASE_MEASUREMENT_ID=""

# Caso utilize o Firestore com o banco de dados padrão, deixe vazio ou "(default)".
# Se estiver usando um banco de dados nomeado customizado, insira o ID aqui:
VITE_FIREBASE_DATABASE_ID=""
